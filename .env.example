# ============ 阿里云 DashScope（必填） ============
# 在 https://dashscope.console.aliyun.com/ 申请
DASH_SCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 想用的 Qwen 模型；常用：qwen-turbo / qwen-plus / qwen-max / qwen-long
QWEN_MODEL=qwen-turbo


# ============ MySQL（docker compose 必填，本地直接跑也要填） ============
# docker compose 时下面这些会被 docker-compose.yml 覆盖
MYSQL_ROOT_PASSWORD=please-change-me-to-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=please-change-me-to-a-strong-password
DB_NAME=ai_chat_db


# ============ JWT（必填） ============
# 生产环境务必用 `openssl rand -hex 32` 生成一个 64 位随机串
JWT_SECRET=please-change-me-to-a-random-64-char-string-xxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ============ 调试选项（可选） ============
# 设为 1 打印所有 SQL（开发排查用，生产永远留 0）
DB_ECHO=0
